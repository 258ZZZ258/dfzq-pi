{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "supervision-upload-material.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentId", "documentVersionId", "fileName", "categoryCode", "documentOrigin", "organizationIds", "uploadEntry", "processingStatus"],
  "properties": {
    "documentId": { "type": "string", "pattern": "\\S" },
    "documentVersionId": { "type": "string", "pattern": "\\S" },
    "fileName": { "type": "string", "pattern": "\\S" },
    "title": { "type": "string" },
    "issueDate": { "type": "string" },
    "categoryCode": { "type": "string", "pattern": "\\S" },
    "documentOrigin": { "enum": ["internal", "external"] },
    "organizationIds": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
    "uploadDepartmentId": { "type": "string", "pattern": "\\S" },
    "uploadedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "uploadEntry": { "enum": ["file-center", "supervision"] },
    "processingStatus": { "enum": ["indexed", "processing", "failed", "needs-metadata", "disabled"] },
    "parseVersion": { "type": "string", "pattern": "\\S" },
    "indexVersion": { "type": "string", "pattern": "\\S" }
  }
}
