{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["compareType", "metrics", "rows", "finish_reason"],
  "additionalProperties": false,
  "properties": {
    "compareType": { "enum": ["external_to_internal", "internal_to_external"] },
    "metrics": {
      "type": "object",
      "required": ["checked", "missing", "conflict", "covered", "unmatched", "linked"],
      "additionalProperties": false,
      "properties": {
        "checked": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 },
        "conflict": { "type": "integer", "minimum": 0 },
        "covered": { "type": "integer", "minimum": 0 },
        "unmatched": { "type": "integer", "minimum": 0 },
        "linked": { "type": "integer", "minimum": 0 }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "tabKey", "conflictType", "externalClause", "internalClause", "judgement", "source", "suggestion", "basis"],
        "additionalProperties": false,
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "tabKey": { "enum": ["missing", "error"] },
          "conflictType": { "type": "string", "minLength": 1 },
          "externalClause": { "type": "string" },
          "internalClause": { "type": "string" },
          "judgement": { "type": "string", "minLength": 1 },
          "source": { "type": "string" },
          "suggestion": { "type": "string" },
          "basis": {
            "type": "object",
            "required": ["internalChunkId", "matchKind"],
            "additionalProperties": false,
            "properties": {
              "internalChunkId": { "type": "string" },
              "internalSourceCode": { "type": ["string", "null"] },
              "externalClausePath": { "type": ["string", "null"] },
              "externalDocNo": { "type": ["string", "null"] },
              "matchKind": { "enum": ["exact", "normalized", "doc_level", "semantic_retrieval"] },
              "referenceId": { "type": "string" },
              "referenceSurface": { "type": "string" },
              "citedDocVersionId": { "type": ["string", "null"] },
              "currentDocVersionId": { "type": ["string", "null"] },
              "changeKind": { "enum": ["unresolved", "version_changed", "clause_changed"] }
            }
          }
        }
      }
    },
    "linkedDetail": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "content"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "content": { "type": "string" },
          "sourceId": { "type": ["string", "null"] },
          "sourceType": { "enum": ["external_clause", "internal_clause", "audit_rule", "check_point"] }
        }
      }
    },
    "gaps": { "type": "array", "items": { "type": "string" } },
    "finish_reason": { "enum": ["stop", "refused"] }
  }
}
