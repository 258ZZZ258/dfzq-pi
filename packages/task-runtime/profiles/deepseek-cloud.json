{
	"id": "deepseek-cloud",
	"baseUrl": "https://api.deepseek.com",
	"apiKeyEnv": "LLM_API_KEY",
	"api": "openai-completions",
	"roles": {
		"main": {
			"provider": "deepseek",
			"modelId": "deepseek-v4-flash",
			"contextWindow": 1000000,
			"maxTokens": 4096,
			"reasoning": true,
			"cost": { "input": 1, "output": 6, "cacheRead": 0.025, "cacheWrite": 1 }
		}
	}
}
