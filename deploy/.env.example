# dfzq-pi/deploy/.env.example —— 五容器栈(pg / etcd / minio / milvus / pi)的环境变量样板
#
# 复制成 deploy/.env(🔴 与 compose.yml 同级,**不是** ops/.env),权限须 0600:
#     cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
# ops/deploy.sh 第 1 步会检查:文件在不在、权限是不是 600、必填项是不是空。
#
# 标 `# 必填` 的项脚本填不了 / 不该由脚本填(凭证、需人读网关文档才知道的值),
# 必须现场手工填。
#
# 🔴 这份文件被 compose 用在**两个**地方,两处规则不一样:
#   1. 变量插值 —— compose.yml 里的 ${PI_IMAGE} / ${PG_PASSWORD} / ${PG_PORT} 等
#   2. pi 容器的 env_file —— **整份文件逐行**注入 pi 容器的环境变量
#   由此两条书写纪律:
#   · 行尾不要写注释。compose 的 env_file 解析**不剥**行尾注释,`FOO=bar # 说明`
#     会让 FOO 的值变成 `bar # 说明`。注释一律另起一行,以 # 开头。
#   · 不要用 `~` 或 `$OTHER_VAR`。env_file 不做 shell 展开,两者都按字面量处理。
#
# 🔴 路径类的值一律是**容器内**路径。这份文件是给容器吃的,不是给宿主吃的。

# ============================================================
# pi 镜像
# ============================================================
# 必填:pi 镜像的完整引用(registry / 仓库 / tag 三段齐全)。
# tag 用 dfzq-pi 的 git sha 前 7 位(不可变 tag,不锁 digest —— 镜像 push 到 JFrog
# 之后 digest 会被重新计算,照抄 Docker Hub 上那串会让 pull 直接失败)。
# 升版本 / 回滚都不必手改这里:`./ops/deploy.sh --tag <sha>` 会临时替换掉 tag 段。
PI_IMAGE=jfrog.orientsec.com.cn/dev7-docker-release-local/dfzq-pi:0000000

# ============================================================
# task-runtime serve —— 全部 requireEnv,缺一即启动失败
# ============================================================
# 这是**宿主**上的发布端口(承 predeploy 的既有口径),运维在本机 curl / 配代理时用它。
# 容器内 serve 一律监听 18080,不受这个值影响 —— compose.yml 的 pi.environment 里
# 有一行 TASK_RUNTIME_PORT: "18080" 把它钉死了(environment: 的优先级高于 env_file)。
# ⇒ 改这一项只改宿主端口,是安全的;ops 的四个脚本探 /healthz 时也跟着用它。
TASK_RUNTIME_PORT=18080
# 本环境不做鉴权;requireEnv 硬性必填,删不掉,填固定占位值即可。
# 🔴 禁止把 18080 暴露到办公网段 —— 没有任何鉴权,暴露即等于任人调用。
# compose.yml 把端口绑在 127.0.0.1 上就是为了这条,不要改成 0.0.0.0。
TASK_RUNTIME_INTERNAL_TOKEN=dfzq-no-auth-placeholder
# 必填:PG 连接串。
# 🔴 主机名是 compose 的**服务名** `pg`、端口是**容器网络内**的 5432 ——
#    不是 127.0.0.1,也不是下面那个 PG_PORT(那是发布到宿主的端口,pi 容器不走它)。
# 🔴 密码要和下面的 PG_PASSWORD 是同一个,且要**URL 编码**(密码里有 @ : / ? # 等
#    字符时不编码会把连接串解析成别的意思)。换 PG_PASSWORD 时这里必须跟着换。
# 🔴 sqlite 存储已从 task-runtime 移除,旧文档里的 TASK_RUNTIME_DB_PATH 是死变量,
#    serve 真正要的是这一条,填错/留空直接启动失败。
PIPELINE_DB_DSN=postgresql+psycopg://pipeline:<URL编码后的密码>@pg:5432/audit_pipeline
# 下面三项都是**容器内**路径,写在这里是为了让 deploy.sh 的必填项检查有东西可查。
# 🔴 env_file 的优先级高于镜像 ENV,这三项填错会**覆盖掉**镜像里正确的值,
#    而且是那种"配置看着没毛病、容器就是起不来"的错法。除非镜像布局变了,不要改。
TASK_RUNTIME_SPECS_DIR=/app/packages/task-runtime/specs
# 🔴 必须是 /data/config/gateway.json —— entrypoint.sh 在容器启动时把 gateway.json
# **渲染到这个路径**(profiles/ 下只有 deepseek-cloud.json,**没有 gateway.json**;
# 那个文件一直是 predeploy 在宿主上渲染出来的)。
# env_file 的优先级高于镜像 ENV,这里填错会覆盖掉 Dockerfile 的正确默认值,
# 指向一个既不存在、也不是渲染目标的路径 —— entrypoint 会 die(profile-path-mismatch)。
TASK_RUNTIME_PROFILE=/data/config/gateway.json
TASK_RUNTIME_WORK_ROOT=/data/work
# 必填:LLM 网关 key。gateway.json 的 apiKeyEnv 指向这个变量名;缺了它 serve
# 在启动期(不是第一次调用时)就 fail-closed 拒绝启动。
LLM_API_KEY=

# ============================================================
# MCP 子进程(policy-query)
# ============================================================
# 未配置 C1(query.mcp.server 的审计日志)启动失败,不是可选项。
# 容器内路径,落在 runtime_data 卷的 /data 上,容器重建不丢。
POLICY_MCP_AUDIT_LOG=/data/logs/policy-mcp-audit.jsonl
# 内网无法访问 HuggingFace,必须为 1,否则会在启动时去联网拉模型元数据然后卡住。
HF_HUB_OFFLINE=1
# ⚠ DFZQ_AUDIT_AI_PYTHON / DFZQ_AUDIT_AI_ROOT / PIPELINE_CONFIG_DIR 三项已经固化
#   进镜像的 ENV(venv 与 audit-ai 源码都在镜像里,路径不会变),这里不再登记,
#   也**不要**手工加回来 —— 加了就会覆盖镜像里正确的值。

# ============================================================
# audit-ai 侧 —— entrypoint.sh 用它们渲染容器内的 settings.toml
#
# 🔴 这些变量本身**不会**直接传进 query.mcp.server 子进程:该子进程按白名单 env
# 启动(安全方案 L1(a)),specs/policy-query.json 的 mcpServers[0].env 只转发
# PIPELINE_CONFIG_DIR / POLICY_MCP_AUDIT_LOG / HF_HUB_OFFLINE / PATH 四项。
# 它们真正生效,靠的是容器启动时 entrypoint.sh 把值写进 settings.toml 的
# [db] / [milvus] / [embedding] / [query] 段。
# ============================================================
# ⚠ 下面两项 compose.yml 的 environment: 段会强制覆盖成 milvus / 19530
#   (environment: 的优先级高于 env_file)。这里填什么都不影响运行,登记在此
#   只是让人一眼看得出容器里连的是谁。
PIPELINE_MILVUS_HOST=milvus
PIPELINE_MILVUS_PORT=19530
# ⚠ 这里**刻意没有** PIPELINE_MILVUS_COLLECTION:容器里 collection 名取的是
#   settings.toml 的出厂值 audit_corpus,entrypoint.sh 不渲染这一项,写在这里
#   不会有任何效果。宿主侧探针要改 collection 名,改 predeploy 的 conf/.env。
PIPELINE_EMBEDDING_MODE=endpoint
# 本地模型名。endpoint 模式下只作记录用,真正调的是下面 ENDPOINT_MODEL。
PIPELINE_EMBEDDING_MODEL=BAAI/bge-m3
# 必填:嵌入网关地址。
PIPELINE_EMBEDDING_BASE_URL=
# 必填:嵌入网关 key。
PIPELINE_EMBEDDING_API_KEY=
# 网关上的嵌入模型注册名;留空则代码回落 BAAI/bge-m3。
PIPELINE_EMBEDDING_ENDPOINT_MODEL=
# 必填:bge 或 bm25。现场实测结论是 bm25(嵌入网关不返 sparse_embedding)。
# 🔴 这一项决定 Milvus collection 的**形态**,而 collection 建好就不再重建。
#    先定这个值,再跑 deploy.sh;建完之后再改这里,init 会直接报错拒绝复用,
#    不会静默地拿一个形态对不上的 collection 继续跑。
PIPELINE_SPARSE_BACKEND=bm25
QUERY_RERANK_BACKEND=api
# 必填:重排网关地址。
QUERY_RERANK_BASE_URL=
# 必填:重排网关 key。
QUERY_RERANK_API_KEY=
# 留空则用 audit-ai 自己的缺省 BAAI/bge-reranker-v2-m3。
QUERY_RERANK_MODEL=
# 重排网关的路径段(接在 BASE_URL 后面)。留空 = 沿用出厂值。
QUERY_RERANK_PATH=
# 重排分数低于这个值的结果丢弃。留空 = 沿用出厂值。
QUERY_RERANK_MIN_SCORE=
# agent 路径的 LLM 走 gateway.json;query 侧的 LLM 只在摘要富集用,本环境不开。
QUERY_LLM_BACKEND=stub

# ============================================================
# LLM 网关 —— entrypoint.sh 用它们渲染 profiles/gateway.json
# ============================================================
# 必填。
LLM_BASE_URL=
# 必填。
LLM_MODEL=
# 必填:网关的上下文窗口(token 数)。⚠ 网关多半不通过 API 暴露这个值,探不到,
# 必须由人在现场按网关文档手工填。填 0 是个"明显不对"的哨兵值,提醒尽快改。
LLM_CONTEXT_WINDOW=0
# 网关的单次输出上限。若实际低于 4096 必须填,否则会在长回答上被网关截断。
LLM_MAX_TOKENS=4096
# 网关的协议族。留空 = openai(绝大多数内网网关都是 OpenAI 兼容接口)。
LLM_PROVIDER=
# 网关是不是"思考型"模型。留空 = false。
LLM_REASONING=

# ============================================================
# 数据层 —— compose.yml 直接插值用
# ============================================================
# 必填:PG 的 pipeline 用户密码。compose.yml 里 POSTGRES_PASSWORD 靠它渲染,
# 未设置直接拒绝启动(不再有硬编码弱口令)。
# 🔴 改这一项必须同步改上面 PIPELINE_DB_DSN 里的密码段(URL 编码后),
#    两边对不上时 pg 起得来、pi 连不上,表现是 /healthz 不绿。
PG_PASSWORD=
# 下面三个是**发布到宿主 127.0.0.1 上**的端口,只给运维本机排查用
# (psql / attu / curl)。容器之间互相访问不走它们,改了不影响 pi。
PG_PORT=5432
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091
# compose 的项目名。🔴 顶层不能写 name: 键(compose 1.29.2 的顶层键白名单里没有
# 它,多这一行整份 compose.yml 在解析阶段就被拒),项目名只能走这个变量。
# 改了它 = 换一套容器名和卷名 = 老数据卷不再被挂载,看起来像"数据没了"。不要改。
COMPOSE_PROJECT_NAME=dfzq-policy

# ============================================================
# 到这里为止就是五容器栈要的全部
# ============================================================
# ⚠ 现场还有**另一份** env:predeploy 工具箱的 `conf/.env`(样板 conf/env.example)。
#   那一份是**宿主侧**的,给跑在宿主上的语料灌库(60/65/67/70)、探针(90–94)、
#   web 代理(80)用。两份不能互相替代,同一个变量名在两侧要的是两个不同的值:
#     · 本文件(容器侧):PIPELINE_DB_DSN 连服务名 pg 的 5432、
#       PIPELINE_MILVUS_HOST=milvus —— 走 compose 网络内部,不经宿主端口。
#     · conf/.env(宿主侧):`pg` / `milvus` 这两个名字在宿主上根本解析不了,
#       必须连 127.0.0.1:<发布端口>。
#   所以下面这些**不要**往本文件里加,它们只属于宿主侧那一份:
#     PRESEG_SOURCE_DSN / DM_HOST / DM_PORT
#     PIP_INDEX_URL / PIP_TRUSTED_HOST / NPM_REGISTRY
#     EMBEDDING_* / RERANK_*(探针 35-probe-gateway.sh 用的那一组)
#     WEB_* / ANNOTATIONS_DB / ASK_* / POLL_HTTP_TIMEOUT_S
#   加进来不会报错,但整份文件会被逐行注入 pi 容器 —— 多一份用不上的凭证,
#   也多一个会和宿主侧漂移的第二事实来源。
#
# ⚠ 没有登记在本文件里的配置项,一律沿用镜像里 settings.toml 的出厂值。
#   要调出厂值之外的东西,找开发,不要凭猜测往这里加变量名。
