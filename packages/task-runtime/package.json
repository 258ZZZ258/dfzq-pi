{
	"name": "@dfzq/task-runtime",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"test": "vitest --run",
		"test:audit-report": "vitest --run test/audit-report-agent.test.ts && python scripts/audit-report/test_render_report_docx.py",
		"render:audit-report": "python scripts/audit-report/render_report_docx.py",
		"test:supervision-report": "python scripts/supervision-analysis/test_render_supervision_analysis_docx.py",
		"render:supervision-report": "python scripts/supervision-analysis/render_supervision_analysis_docx.py",
		"generate:supervision-narrative": "tsx scripts/supervision-analysis/generate_deepseek_narrative.ts",
		"export:supervision-document": "tsx scripts/supervision-analysis/export_report_document.ts",
		"test:supervision-narrative-report": "python scripts/supervision-analysis/test_render_supervision_narrative_docx.py",
		"render:supervision-narrative-report": "python scripts/supervision-analysis/render_supervision_narrative_docx.py"
	},
	"bin": {
		"task-runtime": "./src/cli/main.ts"
	},
	"dependencies": {
		"@e965/xlsx": "0.20.3",
		"@earendil-works/pi-coding-agent": "^0.82.1",
		"@hono/node-server": "2.0.12",
		"hono": "4.12.32",
		"minio": "8.0.7",
		"postgres": "3.4.8",
		"typebox": "1.1.38"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.82.1",
		"@types/node": "24.12.4",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
